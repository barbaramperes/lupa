{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": { "@lupa/core": ["./packages/core/src/index.ts"] },
    "baseUrl": "."
  },
  "include": ["packages/**/*.ts", "apps/api/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "**/dist", "apps/web"]
}
